app HelpBook {
  wasp: {
    version: "^0.18.0"
  },
  title: "HelpBook",
  head: [
    "<link rel='icon' href='/favicon.ico' />",
  ],
  client: {
    rootComponent: import { Layout } from "@src/Layout.jsx",
  },
  auth: {
    userEntity: User,
    methods: {
      usernameAndPassword: {}
    },
    onAuthFailedRedirectTo: "/login",
    onAuthSucceededRedirectTo: "/"
  },
}
route LoginRoute { path: "/login", to: LoginPage }
page LoginPage {
  component: import Login from "@src/pages/auth/Login.jsx"
}
route SignupRoute { path: "/signup", to: SignupPage }
page SignupPage {
  component: import Signup from "@src/pages/auth/Signup.jsx"
}
action createJob {
  fn: import { createJob } from "@src/actions.js",
  entities: [Job, AuditLog]
}
action applyToJob {
  fn: import { applyToJob } from "@src/actions.js",
  entities: [Application, Job, WorkerProfile, AuditLog]
}
action acceptApplication {
  fn: import { acceptApplication } from "@src/actions.js",
  entities: [Application, AuditLog]
}
query getJobDetails {
  fn: import { getJobDetails } from "@src/queries.js",
  entities: [Job, Application, Shift]
}
query getWorkerProfile {
  fn: import { getWorkerProfile } from "@src/queries.js",
  entities: [WorkerProfile, Certification, AvailabilitySlot]
}
route DashboardRoute { path: "/", to: DashboardPage }
page DashboardPage {
  component: import DashboardPage from "@src/pages/Dashboard.jsx",
  authRequired: true
}
route JobDetailRoute { path: "/jobs/:id", to: JobDetailPage }
page JobDetailPage {
  component: import JobDetailPage from "@src/pages/JobDetail.jsx",
  authRequired: true
}
route WorkerProfileRoute { path: "/workers/profile", to: WorkerProfilePage }
page WorkerProfilePage {
  component: import WorkerProfilePage from "@src/pages/WorkerProfile.jsx",
  authRequired: true
}
